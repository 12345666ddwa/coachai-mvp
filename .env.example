# Copy to .env and fill in real values:  cp .env.example .env
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible endpoint override:
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional Gemini configuration (select provider="gemini" in agents/models.py)
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GEMINI_MODEL=gemini-3.8-flash

# Optional DeepSeek configuration (select provider="deepseek" in agents/models.py)
# DEEPSEEK_API_KEY=your-deepseek-api-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-v4-flash

# --- Optional: local Ollama (free, runs on your own machine) ---
# No API key is needed for local Ollama; just install it and `ollama pull` a model.
# Uncomment below if your Ollama listens on a non-default address/model.
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=qwen2.5:7b
