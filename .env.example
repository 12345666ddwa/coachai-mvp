# Copy to .env and fill in real values:  cp .env.example .env
DEEPSEEK_API_KEY=***
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-v4-flash

# --- Optional: local Ollama (free, runs on your own machine) ---
# No API key is needed for local Ollama; just install it and `ollama pull` a model.
# Uncomment below if your Ollama listens on a non-default address/model.
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=qwen2.5:7b
